# Server Configuration
PORT=4000
NODE_ENV=development

# Database Connection (MySQL)
DATABASE_URL="mysql://root:password@localhost:3306/autoshop"

# Session & Security
COOKIE_SECRET="change-this-to-a-very-long-and-secure-random-secret"
COOKIE_SECURE=false
COOKIE_SAMESITE="lax"

# CORS & Web URLs
# In production on split domain (e.g. marks.chromopay.com + auto.chromopay.com):
# PUBLIC_API_URL="https://auto.chromopay.com"
# PUBLIC_WEB_URL="https://marks.chromopay.com"
# CORS_ORIGIN="https://marks.chromopay.com,https://auto.chromopay.com"
# COOKIE_SAMESITE="none"
# COOKIE_SECURE=true
CORS_ORIGIN="http://localhost:5173"
PUBLIC_WEB_URL="http://localhost:5173"
PUBLIC_SHOP_SLUG="marks-tire-muffler"

# Payment Providers
PAYMENT_PROVIDER="mock"
DEMO_PAYMENTS=true
